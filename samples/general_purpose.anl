# Proves AnnealScript is general-purpose now: user-defined functions,
# recursion, control flow, and arithmetic -- not just intent/bound blocks.

fn factorial(n: int) -> int {
  if n <= 1 {
    return 1
  }
  return n * factorial(n - 1)
}

fn fibonacci(n: int) -> int {
  if n <= 1 {
    return n
  }
  return fibonacci(n - 1) + fibonacci(n - 2)
}

print(factorial(6))
print(fibonacci(10))

# while loop + arithmetic: sum of squares 1..5
let i = 1
let total = 0
while i <= 5 {
  set total = total + i * i
  set i = i + 1
}
print(total)

# it still does everything from before, in the same program
struct Reading {
  level: int default 0
}
let raw = {"level": "12"}
intent raw -> Reading as r

let speed = 0
bound speed <= 15 {
  if r.level > 15 {
    set speed = 15
  } else {
    set speed = r.level
  }
}
print(speed)
