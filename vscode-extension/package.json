{
  "name": "annealscript",
  "displayName": "AnnealScript",
  "description": "Syntax highlighting, diagnostics, and Run & Profile for AnnealScript (.anl)",
  "version": "0.1.0",
  "publisher": "annealscript-alpha",
  "private": true,
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:annealscript"],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "annealscript",
        "aliases": ["AnnealScript"],
        "extensions": [".anl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "annealscript",
        "scopeName": "source.annealscript",
        "path": "./syntaxes/annealscript.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "AnnealScript",
      "properties": {
        "annealscript.serverPath": {
          "type": "string",
          "default": "annealscript-lsp",
          "description": "Path to the annealscript-lsp binary (defaults to looking it up on PATH)."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
