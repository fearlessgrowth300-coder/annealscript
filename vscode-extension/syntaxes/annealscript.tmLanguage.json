{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AnnealScript",
  "scopeName": "source.annealscript",
  "fileTypes": ["anl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#function-calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [{ "name": "comment.line.number-sign.annealscript", "match": "#.*$" }]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.annealscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.annealscript", "match": "\\\\." }]
        }
      ]
    },
    "numbers": {
      "patterns": [{ "name": "constant.numeric.annealscript", "match": "\\b\\d+(\\.\\d+)?\\b" }]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.annealscript",
          "match": "\\b(struct|let|set|intent|bound|as|print|default|resolve|above|else|if|while|for|in|fn|return|break|continue)\\b"
        },
        { "name": "constant.language.annealscript", "match": "\\b(true|false)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.annealscript", "match": "\\b(int|float|bool|string|Probability)\\b" },
        { "name": "entity.name.type.struct.annealscript", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.annealscript", "match": "->|=>|<=|>=|==|!=|&&|\\|\\||[+\\-*/%!<>=]" }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.annealscript"
        }
      ]
    }
  }
}
